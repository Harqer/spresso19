                    stylingLoading = stylingLoading,
                    curatedFits = curatedFits
                )
            }

            wardrobePhotoGalleryGrid(
                photos = photos,
                handleAddPhoto = handleAddPhoto,
                onSelectTryOn = onSelectTryOn
            )
        }
    }
