@Composable
fun SmartVisionViewport(
    activeImage: ByteArray?,
    isScanning: Boolean,
    detectedItems: List<DetectedItem>,
    inventory: List<ProductItem>,
    apiClient: ApiClient,
    onSelectProduct: (String) -> Unit,
    onHitlCheckout: (HITLPayload) -> Unit,
