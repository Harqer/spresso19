Optimizes byte array extraction from JS ArrayBuffer.  
Kotlin

package ui

import androidx.compose.runtime.Composable
import kotlinx.browser.document
import org.khronos.webgl.Int8Array
import org.w3c.dom.HTMLInputElement
import org.w3c.dom.events.Event
import org.w3c.files.FileReader

@Composable
actual fun rememberImagePicker(
    onFrameCaptured: ((ByteArray) -> Unit)?,
    onImagePicked: (ByteArray?) -> Unit
): () -> Unit {
    return {
        val input = document.createElement("input") as HTMLInputElement
        input.type = "file"
        input.accept = "image/*"
        input.onchange = { _: Event ->
            val file = input.files?.item(0)
            if (file != null) {
                val reader = FileReader()
                reader.onload = {
                    val arrayBuffer = reader.result as org.khronos.webgl.ArrayBuffer
                    val intArray = Int8Array(arrayBuffer)
                    val bytes = ByteArray(intArray.length)
                    for (i in 0 until intArray.length) {
                        bytes[i] = intArray[i]
                    }
                    onImagePicked(bytes)
                    null
                }
                reader.readAsArrayBuffer(file)
            } else {
                onImagePicked(null)
            }
            null
        }
        input.click()
    }
}

