    LaunchedEffect(activeSeason) {
        stylingLoading = true
        try {
            SpressoBackend.getWardrobeOutfits()
            // Population sample for curated fits
            curatedFits = listOf(
                CuratedFit(
                    fitName = "$activeSeason Essential Layers",
                    season = activeSeason,
                    stylingNotes = "Thermal layering paired with weatherproof outerwear.",
                    items = listOf("Cashmere Sweater", "Shearling Jacket", "Tailored Trousers")
