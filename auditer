        "            \"\": [\"query\"],                        # Default endpoint\n",

        "            \"stream\": [\"stream_query\"],           # Streaming endpoint\n",

        "            \"bidi_stream\": [\"bidi_stream_query\"]  # Bidirectional endpoint\n",

        "        }"

      ]

