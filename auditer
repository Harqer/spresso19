@JsFun("""
function(int8Array) {
    // Gemini Live API returns 24kHz 16-bit Little-Endian PCM audio
    if (!window.playerAudioContext) {
        window.playerAudioContext = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 24000 });
        window.nextAudioStartTime = 0;
    }
    const ctx = window.playerAudioContext;
    if (ctx.state === 'suspended') {
        ctx.resume();
    }

    // Decode 16-bit PCM bytes to Float32 AudioBuffer (-1.0 to 1.0)
    const pcm16 = new Int16Array(int8Array.buffer, int8Array.byteOffset, Math.floor(int8Array.byteLength / 2));
    const float32 = new Float32Array(pcm16.length);
    for (let i = 0; i < pcm16.length; i++) {
        float32[i] = pcm16[i] / 32768.0;
    }

    const audioBuffer = ctx.createBuffer(1, float32.length, 24000);
    audioBuffer.getChannelData(0).set(float32);

    const source = ctx.createBufferSource();
    source.buffer = audioBuffer;
    source.connect(ctx.destination);

    // Queue audio chunks sequentially without gaps or overlaps
    const startTime = Math.max(ctx.currentTime, window.nextAudioStartTime);
    source.start(startTime);
    window.nextAudioStartTime = startTime + audioBuffer.duration;
}
""")
internal external fun playPcmChunkJs(array: Int8Array)

@JsFun("""
function() {
