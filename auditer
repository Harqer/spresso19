package audio

import org.khronos.webgl.Int8Array

actual class AudioRecorder {
    private var isRecording = false
    actual var onAudioChunk: ((ByteArray) -> Unit)? = null
    
    actual fun startRecording() {
        if (isRecording) return
        isRecording = true
        requestMicrophoneAccess { intArray ->
            // Direct index access avoids 32,000+ @JsFun boundary crossings per second
            val bytes = ByteArray(intArray.length) { i -> intArray[i] }
            onAudioChunk?.invoke(bytes)
        }
    }
    
    actual fun stopRecording() {
        if (!isRecording) return
        isRecording = false
        stopMicrophoneAccess()
    }
    
    actual fun isRecording(): Boolean = isRecording
}

