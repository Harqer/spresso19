import androidx.compose.runtime.remember
import androidx.compose.runtime.rememberCoroutineScope
import kotlinx.coroutines.launch
import network.ApiClient
import kotlin.io.encoding.Base64
import kotlin.io.encoding.ExperimentalEncodingApi

@OptIn(ExperimentalEncodingApi::class)
@Composable
actual fun rememberReceiptScanner(
    onResult: (merchant: String, amount: String) -> Unit,
    onError: (String) -> Unit
): (ByteArray) -> Unit {
    val scope = rememberCoroutineScope()
    val apiClient = remember { ApiClient() }

    return { bytes ->
        scope.launch {
            try {
                val base64Data = Base64.encode(bytes)
                val response = apiClient.performLensSearch(base64Data)
                val firstItem = response.detectedResult?.detectedItems?.firstOrNull()
                val merchant = firstItem?.brandGuess 
                    ?: firstItem?.detectedName 
