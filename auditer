package components.features.auth

import androidx.compose.runtime.Composable
import androidx.compose.runtime.remember
import kotlin.coroutines.resume
import kotlin.coroutines.resumeWithException
import kotlin.coroutines.suspendCancellableCoroutine

@Composable
actual fun rememberPasskeyRegistrar(): PasskeyRegistrar {
    return remember {
        object : PasskeyRegistrar {
            override suspend fun registerPasskey(): Pair<String, String> =
                suspendCancellableCoroutine { continuation ->
                    createWebAuthnPasskey(
                        onSuccess = { credentialId, publicKey ->
                            continuation.resume(Pair(credentialId, publicKey))
                        },
                        onError = { errorMsg ->
                            continuation.resumeWithException(IllegalStateException(errorMsg))
                        }
                    )
                }
        }
    }
}

