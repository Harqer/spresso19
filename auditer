            contentScale = ContentScale.Crop,
            modifier = modifier
                .fillMaxSize()
                .then(if (isScanning) Modifier.blur(1.dp) else Modifier)
        )
    }

    if (isScanning) {
        SmartVisionScanningOverlay()
    } else {
        BoxWithConstraints(modifier = Modifier.fillMaxSize()) {
            val width = maxWidth
            val height = maxHeight
            detectedItems.forEach { item ->
                val matchedProduct = inventory.find { it.id == item.matchingCatalogId }
                SmartVisionDetectionOverlay(
                    item = item,
                    matchedProduct = matchedProduct,
                    width = width,
                    height = height,
                    apiClient = apiClient,
                    onSelectProduct = onSelectProduct,
                    onHitlCheckout = onHitlCheckout
                )
            }
        }
    }
}

An audit of the wardrobe feature components (components.features.wardrobe) identified an uninitialized UI state bug in StackedWardrobeDecks.kt, missing root layout Modifier parameters, and unused wildcard imports.  
Code Audit Findings

    Unpopulated Decks State Bug (StackedWardrobeDecks.kt): var decks by remember ... { mutableStateOf<List<ComposeWardrobeDeck>>(emptyList()) } was never populated with initial items, causing decks.forEach to execute against an empty list and render no deck cards.  

    Missing Root Layout Modifiers (GallerySyncDisabledView.kt, WardrobeHeaderBanner.kt): Both composable signatures lacked a default modifier: Modifier = Modifier parameter, preventing parent layouts from passing modifiers directly.  

    Redundant & Wildcard Imports: components.models.* wildcard imports were present across multiple files alongside redundant self-package declarations.  

