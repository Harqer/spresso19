                                        color = MaterialTheme.colorScheme.primaryContainer
                                    ) {
                                        Text("Default", modifier = Modifier.padding(horizontal = 8.dp, vertical = 2.dp), fontSize = 10.sp, fontWeight = FontWeight.Bold)
                                    }
