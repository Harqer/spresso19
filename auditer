import androidx.compose.ui.graphics.Color
import androidx.compose.ui.unit.Dp
import androidx.compose.ui.unit.dp

/**
 * A standalone card component that implements the "Liquid Glass UI" aesthetic
 * found in modern Spatial Computing interfaces.
 * 
 * Features a translucent gradient background and a specular highlight border
 * to give the illusion of physical glass depth across both Light and Dark themes.
 */
@Composable
fun LiquidGlassCard(
    modifier: Modifier = Modifier,
    cornerRadius: Dp = 24.dp,
    contentPadding: PaddingValues = PaddingValues(16.dp),
    glassColor: Color = MaterialTheme.colorScheme.surface,
    borderColor: Color = MaterialTheme.colorScheme.outlineVariant,
    content: @Composable BoxScope.() -> Unit
) {
    val shape = RoundedCornerShape(cornerRadius)

    Box(
        modifier = modifier
            .clip(shape)
            // Translucent glass body adapted to the active color scheme
            .background(
                Brush.linearGradient(
                    colors = listOf(
                        glassColor.copy(alpha = 0.30f),
                        glassColor.copy(alpha = 0.10f)
                    )
                )
            )
            // Specular edge highlight (simulates 3D glass thickness)
            .border(
                width = 1.dp,
                brush = Brush.linearGradient(
                    colors = listOf(
                        borderColor.copy(alpha = 0.5f),
                        borderColor.copy(alpha = 0.1f),
                        borderColor.copy(alpha = 0.1f),
                        borderColor.copy(alpha = 0.3f)
                    )
                ),
                shape = shape
            )
            .padding(contentPadding),
        content = content
    )
}

