AudioPlayer.kt (WasmJS Web Audio API Engine)
Replaces empty stubs with a Web Audio API 24kHz PCM audio buffer player to stream Gemini Live responses.  
Kotlin

package audio

import kotlinx.browser.window

actual class AudioPlayer {
    private var audioContext: dynamic = null

    init {
        try {
            val audioContextClass = window.asDynamic().AudioContext ?: window.asDynamic().webkitAudioContext
            if (audioContextClass != null) {
                audioContext = js("new audioContextClass({sampleRate: 24000})")
            }
        } catch (e: Throwable) {
            println("AudioPlayer init error: ${e.message}")
        }
    }

    actual fun playChunk(chunk: ByteArray) {
        if (audioContext == null || chunk.isEmpty()) return
        try {
            val ctx = audioContext
            if (ctx.state == "suspended") {
                ctx.resume()
            }
            
            // 24kHz PCM16 Mono conversion
            val sampleCount = chunk.size / 2
            val audioBuffer = ctx.createBuffer(1, sampleCount, 24000)
            val channelData = audioBuffer.getChannelData(0)

            for (i in 0 until sampleCount) {
                val byteLow = chunk[i * 2].toInt() and 0xFF
                val byteHigh = chunk[i * 2 + 1].toInt()
                val sample = (byteHigh shl 8) or byteLow
                channelData[i] = sample.toFloat() / 32768.0f
            }

            val source = ctx.createBufferSource()
            source.buffer = audioBuffer
            source.connect(ctx.destination)
            source.start()
        } catch (e: Throwable) {
            println("AudioPlayer playChunk error: ${e.message}")
        }
    }

    actual fun stop() {
        try {
            if (audioContext != null && audioContext.state != "closed") {
                audioContext.suspend()
            }
        } catch (_: Throwable) {}
    }

    actual fun release() {
        try {
            if (audioContext != null && audioContext.state != "closed") {
                audioContext.close()
            }
            audioContext = null
        } catch (_: Throwable) {}
    }
}

