    onAddPaymentCard: (() -> Unit)? = null,
    onGoogleWalletAction: (() -> Unit)? = null,
    onConnectCoinbaseWallet: (() -> Unit)? = null,
    modifier: Modifier = Modifier
) {
    Surface(
        modifier = modifier.fillMaxWidth(),
        shape = RoundedCornerShape(20.dp),
