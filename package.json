{
  "name": "spresso",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "./gradlew :composeApp:wasmJsBrowserDevelopmentRun",
    "build": "./gradlew :composeApp:wasmJsBrowserDistribution",
    "clean": "./gradlew clean && rm -rf dist server.cjs",
    "lint": "tsc -p convex/tsconfig.json --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "test:integration": "node scripts/smoke/production-smoke.mjs",
    "test:smoke": "node scripts/test/production-smoke.test.mjs && node scripts/test/no-synthetic-success.test.mjs && node --test scripts/test/convex-bridge-boundary.test.mjs scripts/test/discovery-boundary.test.mjs scripts/test/lens-boundary.test.mjs",
    "test:contracts": "node scripts/test/verify-function-contracts.test.mjs",
    "test:mcp": "node --test mcp-server/server.test.mjs",
    "test:ci-wiring": "node --test scripts/test/ci-wiring.test.mjs",
    "test:convex-cutover": "node --test scripts/test/convex-cutover.test.mjs",
    "test:bundle-budget": "node scripts/test/bundle-budget.test.mjs",
    "gitnexus:status": "node scripts/gitnexus/guard.mjs status",
    "gitnexus:analyze": "node scripts/gitnexus/guard.mjs analyze",
    "gitnexus:refresh": "node scripts/gitnexus/guard.mjs refresh",
    "gitnexus:watch": "node scripts/gitnexus/guard.mjs watch",
    "gitnexus:handoff": "node scripts/gitnexus/handoff.mjs",
    "gitnexus:hooks": "node scripts/gitnexus/install-hooks.mjs",
    "start:mcp": "node mcp-server/server.mjs",
    "lavish": "tsx scripts/lavish.ts"
  },
  "dependencies": {
    "@convex-dev/agent": "^0.7.2",
    "@convex-dev/ai-sdk-provider": "^0.1.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@google/genai": "^2.21.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.94",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.124",
    "parallel-web": "^1.3.0",
    "stripe": "^22.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.2.0",
    "convex-test": "^0.0.56",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "uuid": "^11.1.1",
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0",
    "js-yaml": "^3.15.2",
    "hono": "^4.13.7"
  }
}
