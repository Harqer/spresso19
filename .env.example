# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Optional API key for @openai/agents multi-agent executions.
OPENAI_API_KEY=

# APIFY_API_TOKEN: Token for Apify browser automation, web scraping, and actor runs.
APIFY_API_TOKEN=

# APIFY_ACTOR_ID: Apify Actor ID for browser control and form filling (e.g. lucid_boiler~my-actor).
APIFY_ACTOR_ID=

# Cloudflare Kitesurf / Browser Run: account ID + API token (Browser Rendering - Edit permission).
# Used by executeKitesurfPurchase for autonomous search/scraping (Quick Actions) and checkout (CDP via puppeteer-core).
# Create a token at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# API2Cart Unified E-Commerce API Key (Access to 60+ Platforms: Shopify, WooCommerce, Magento, etc.)
API2CART_API_KEY=

# Coinbase Developer Platform (CDP) agent-wallet credentials are SERVER-ONLY.
# Store them in Firebase Secret Manager / GCP Secret Manager; never in client env.
# Used exclusively by Firebase Functions (prepareAgentTransfer/confirmAgentTransfer).
# CDP_API_KEY_ID, CDP_API_KEY_SECRET, CDP_WALLET_SECRET

# Spresso personal stablecoin (server-only, settlement token for agent wallets):
# ERC-20 contract address of the operator's token, its display symbol, and decimals.
# SPRESSO_TOKEN_CONTRACT_ADDRESS, SPRESSO_TOKEN_SYMBOL, SPRESSO_TOKEN_DECIMALS

# NVIDIA NIM / NeMo Guardrails Agentic Purchasing Engine
NVIDIA_NIM_API_KEY=

# Stripe Payments Secret Key
STRIPE_SECRET_KEY=

# Hugging Face Access Token for ViTPose inference API (usyd-dlc/vitpose-base-simple & usyd-dlc/vitpose-large-coco)
HF_TOKEN=

# Model Garden / Cloud Run Endpoint URL for ViTPose
VITPOSE_MODEL_GARDEN_ENDPOINT=
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Public reCAPTCHA Enterprise score-based site key for Firebase App Check web.
# Create one per production Firebase app; never use a reCAPTCHA secret key here.
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# Server-only credentials. Store these in Firebase Secret Manager; never expose
# them through VITE_* variables or commit them to an .env file.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_KEY_SECRET=
