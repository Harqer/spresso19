# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Optional API key for @openai/agents multi-agent executions.
OPENAI_API_KEY=

# APIFY_API_TOKEN: Token for Apify browser automation, web scraping, and actor runs.
APIFY_API_TOKEN=

# APIFY_ACTOR_ID: Apify Actor ID for browser control and form filling (e.g. lucid_boiler~my-actor).
APIFY_ACTOR_ID=

# API2Cart Unified E-Commerce API Key (Access to 60+ Platforms: Shopify, WooCommerce, Magento, etc.)
API2CART_API_KEY=

# Coinbase AgentKit AI Wallet & Crypto Payments (Base Network, USDC/ETH Agentic Settlement)
COINBASE_AGENTKIT_API_KEY=
COINBASE_WALLET_SECRET=

# NVIDIA NIM / NeMo Guardrails Agentic Purchasing Engine
NVIDIA_NIM_API_KEY=

# Stripe Payments Secret Key
STRIPE_SECRET_KEY=

# Cloud SQL PostgreSQL Configuration
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
