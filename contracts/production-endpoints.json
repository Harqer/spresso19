{
  "baseUrl": "https://get-spresso.web.app",
  "routes": [
    { "path": "/health", "methods": ["GET"] },
    { "path": "/user/sync", "methods": ["POST"] },
    { "path": "/user/preferences", "methods": ["GET", "POST"] },
    { "path": "/user/wallet/coinbase", "methods": ["POST"] },
    { "path": "/cart", "methods": ["GET", "POST"] },
    { "path": "/orders", "methods": ["GET"] },
    { "path": "/products", "methods": ["GET"] },
    { "path": "/products/:productId", "methods": ["GET"] }
  ],
  "endpoints": [
    {
      "name": "products",
      "method": "GET",
      "path": "/api/products",
      "expectedStatuses": [401, 403],
      "requiresJson": true
    },
    {
      "name": "web-api-health",
      "method": "GET",
      "path": "/api/health",
      "expectedStatuses": [200, 503],
      "requiresJson": true
    }
  ]
}
