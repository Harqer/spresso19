rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidUrl(urlStr) {
      return isValidString(urlStr, 8, 2048) && (urlStr.matches('^https://.*') || urlStr.matches('^gs://.*'));
    }

    match /logs/{logId} {
      allow create: if isValidId(logId) &&
        request.resource.data.keys().hasOnly(['level', 'message', 'timestamp']) &&
        isValidString(request.resource.data.level, 1, 20) &&
        isValidString(request.resource.data.message, 1, 2000) &&
        (request.resource.data.timestamp is timestamp || request.resource.data.timestamp == null);
      allow read: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['displayName', 'email', 'avatarUrl', 'role', 'onboardingCompleted']) &&
        (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 0, 100)) &&
        (!('email' in request.resource.data) || isValidString(request.resource.data.email, 0, 200)) &&
        (!('avatarUrl' in request.resource.data) || isValidUrl(request.resource.data.avatarUrl));
    }

    // User purchases and orders (state machine & immutability checks)
    match /users/{userId}/orders/{orderId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidId(orderId) &&
        request.resource.data.totalAmount is number &&
        request.resource.data.totalAmount >= 0 &&
        request.resource.data.status == 'pending';
      allow update: if false; // Only backend can update orders
    }

    match /users/{userId}/videos/{videoId} {
      allow read: if isSignedIn() && (isOwner(userId) || resource.data.isPublic == true);
      allow create: if isOwner(userId) &&
        isValidId(videoId) &&
        request.resource.data.keys().hasOnly(['videoUrl', 'videoType', 'isPublic']) &&
        isValidUrl(request.resource.data.videoUrl) &&
        isValidString(request.resource.data.videoType, 1, 50);
      allow update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['videoUrl', 'videoType', 'isPublic']) &&
        request.resource.data.videoUrl == resource.data.videoUrl &&
        request.resource.data.isPublic == resource.data.isPublic &&
        isValidString(request.resource.data.videoType, 1, 50);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/cart/{itemId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(itemId) &&
        request.resource.data.keys().hasOnly(['quantity', 'productId', 'addedAt']) &&
        request.resource.data.quantity is int &&
        request.resource.data.quantity > 0 &&
        isValidString(request.resource.data.productId, 1, 100);
      allow delete: if isOwner(userId);
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isSignedIn() &&
        isValidId(chatId) &&
        request.resource.data.keys().hasOnly(['userId', 'title', 'isPublic', 'createdAt', 'updatedAt']) &&
        request.resource.data.userId == request.auth.uid &&
        isValidString(request.resource.data.title, 1, 100);
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['userId', 'title', 'isPublic', 'createdAt', 'updatedAt']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Chat messages (Append-only logs)
    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
      allow create: if isSignedIn() && 
        get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidString(request.resource.data.content, 1, 10000);
      allow update, delete: if false; // Prevent manipulating AI chat history
    }

    // Gamified XP & Achievements (Server-authoritative only)
    match /users/{userId}/gamification/{docId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only Cloud Functions can award XP, prevents client-side cheating
    }
  }
}
