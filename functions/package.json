{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "build:watch": "tsc --watch",
    "genkit:ui": "npm run build && genkit start -- node lib/ai/dev.js",
    "genkit:flow": "npm run build && genkit flow:run",
    "genkit:verify": "npm run build && node scripts/verify-genkit.cjs",
    "genkit:docs": "genkit docs:list js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/dotprompt": "^0.9.12",
    "@genkit-ai/google-cloud": "^1.42.0",
    "@genkit-ai/google-genai": "^1.42.0",
    "@google-cloud/pubsub": "^6.0.0",
    "@google/genai": "^2.21.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "genkit": "^1.42.0",
    "parallel-web": "^1.3.0",
    "zod": "^4.4.3"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1",
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0",
    "axios": "^1.20.0",
    "@babel/core": "^7.29.6",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "js-yaml": "^3.15.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
