{
  "name": "functions",
  "scripts": {
    "build": "tsc && cp -r src/dataconnect lib/",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "@genkit-ai/dotprompt": "^0.9.12",
    "@genkit-ai/firebase": "^1.41.0",
    "@genkit-ai/google-cloud": "^1.41.0",
    "@genkit-ai/google-genai": "^1.41.0",
    "@google-cloud/logging": "^12.0.1",
    "@google-cloud/pubsub": "^6.0.0",
    "@google-cloud/spanner": "^8.11.0",
    "@google/genai": "^2.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/pg": "^8.21.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^5.0.0",
    "genkit": "^1.41.0",
    "graphql": "^17.0.2",
    "parallel-web": "^1.3.0",
    "pg": "^8.23.0",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  }
}
