{
  "name": "functions",
  "scripts": {
    "build": "tsc && cp -r src/dataconnect lib/",
    "test": "npm run build && node --test test/*.test.js",
    "build:watch": "tsc --watch",
    "genkit:ui": "npm run build && genkit start -- node lib/ai/dev.js",
    "genkit:flow": "npm run build && genkit flow:run",
    "genkit:verify": "npm run build && node scripts/verify-genkit.cjs",
    "genkit:docs": "genkit docs:list js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.55.0",
    "@genkit-ai/dotprompt": "^0.9.12",
    "@genkit-ai/google-cloud": "^1.42.0",
    "@genkit-ai/google-genai": "^1.42.0",
    "@google-cloud/pubsub": "^6.0.0",
    "@google-cloud/spanner": "^8.11.0",
    "@google/genai": "^2.21.0",
    "@simplewebauthn/server": "^13.3.3",
    "@types/pg": "^8.21.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "genkit": "^1.42.0",
    "jsonwebtoken": "^9.0.3",
    "parallel-web": "^1.3.0",
    "pg": "^8.23.0",
    "stripe": "^22.5.0",
    "viem": "^2.56.3",
    "zod": "^4.4.3"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1",
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0",
    "axios": "^1.20.0",
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "genkit-cli": "^1.42.0",
    "tsx": "^4.23.12"
  }
}
