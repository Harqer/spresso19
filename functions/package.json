    "@genkit-ai/google-genai": "^1.41.0",
    "@google-cloud/pubsub": "^6.0.0",
    "@google/genai": "^2.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/pg": "^8.21.0",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "genkit": "^1.41.0",
    "parallel-web": "^1.3.0",
    "pg": "^8.23.0",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "private": true
}
